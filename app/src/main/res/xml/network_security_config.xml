<?xml version="1.0" encoding="utf-8"?>
<!--
  课程项目：云服务运行在本地电脑的 HTTP 端口上，
  因此允许明文流量。生产环境应改为仅允许 HTTPS。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
